# Browser-side platform API base URL. Keep the proxy path for local development.
VITE_PLATFORM_API_BASE_URL=/platform-api

# Upstream platform API used by the Vite development and preview proxies.
VITE_PLATFORM_PROXY_TARGET=http://47.92.110.176:9108

# Development server settings.
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=4395
# Accepts true, false, or a path/URL to open.
VITE_DEV_OPEN=true
# Accepts true, false, or a comma-separated host list (for example: localhost,.example.com).
VITE_DEV_ALLOWED_HOSTS=true
