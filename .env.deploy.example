# 宝塔自动部署示例
# 复制为 .env.deploy.local 后生效

# 是否在 npm run build 结束后自动上传
DEPLOY_AFTER_BUILD=false

# 宝塔服务器 SSH 信息
DEPLOY_HOST=1.2.3.4
DEPLOY_PORT=22
DEPLOY_USER=root

# 站点目录，默认要求位于 /www/wwwroot/ 下
DEPLOY_REMOTE_PATH=/www/wwwroot/your-site

# 可选: SSH 私钥路径
# 不填则使用系统默认密钥或在执行时手动输入密码
DEPLOY_SSH_KEY=C:\Users\Administrator\.ssh\id_rsa

# 可选: 远程临时目录
DEPLOY_REMOTE_TMP_DIR=/tmp/submarine-cable-planner

# 可选: 清空站点目录时保留的文件/目录
DEPLOY_PRESERVE=.user.ini,.well-known

# 如果目标目录不在 /www/wwwroot/ 下，需要显式放开
DEPLOY_ALLOW_ANY_PATH=false
