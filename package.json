{
  "name": "submarine-cable-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:architecture": "node scripts/verify-architecture.mjs",
    "test:cycles": "node scripts/verify-runtime-cycles.mjs",
    "test:attachment-download": "node scripts/verify-platform-attachment-rect-range.mjs",
    "test:excel-import": "node scripts/verify-excel-import.mjs",
    "test:gis-attachment": "node scripts/verify-gis-attachment-parsing.mjs",
    "test:geoserver-wms": "node scripts/verify-geoserver-wms.mjs",
    "test:rpl-export": "node scripts/verify-rpl-export.mjs",
    "test:sld-export": "node scripts/verify-sld-explicit-total-loss.mjs",
    "test:route-results": "node scripts/verify-backend-route-planning-response.mjs && node scripts/verify-route-planning-result.mjs && node scripts/verify-route-frontend-interactions.mjs",
    "test:interface-optimizations": "node scripts/verify-interface-optimizations.mjs",
    "test:pareto-analysis": "node scripts/verify-pareto-analysis.mjs",
    "test:platform-project-open": "node scripts/verify-platform-project-detail-open.mjs",
    "test:planning-devices": "node scripts/verify-system-planning-device-entity-flow.mjs",
    "test:site-management": "node scripts/verify-platform-point-management.mjs",
    "test:system-planning": "npm run test:site-management && node scripts/verify-system-planning-api-payloads.mjs && node scripts/verify-system-planning-clear-all.mjs && node scripts/verify-system-planning-normalization.mjs && node scripts/verify-system-planning-map-placement.mjs && node scripts/verify-system-planning-constraints.mjs && npm run test:planning-devices",
    "test:project-import": "node scripts/verify-project-import-isolation.mjs",
    "test:lifecycle": "node scripts/verify-alarm-websocket-lifecycle.mjs",
    "test:dictionary-source": "node scripts/verify-platform-dictionary-source.mjs",
    "test:regression": "npm run test:architecture && npm run test:cycles && npm run test:attachment-download && npm run test:excel-import && npm run test:gis-attachment && npm run test:geoserver-wms && npm run test:rpl-export && npm run test:sld-export && npm run test:route-results && npm run test:interface-optimizations && npm run test:pareto-analysis && npm run test:platform-project-open && npm run test:system-planning && npm run test:project-import && npm run test:lifecycle && npm run test:dictionary-source"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "@uppy/core": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "clsx": "^2.1.0",
    "cesium": "npm:mars3d-cesium@~1.115.0",
    "exceljs": "^4.4.0",
    "geotiff": "^2.1.3",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.344.0",
    "mars3d": "file:packages/mars3d",
    "mars3d-cesium": "~1.115.0",
    "ol": "^10.7.0",
    "olcs": "^2.23.0",
    "pinia": "^2.1.7",
    "radix-vue": "^1.9.0",
    "shpjs": "^6.2.0",
    "sm-crypto": "^0.4.0",
    "tailwind-merge": "^2.2.1",
    "three": "^0.181.2",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/three": "^0.181.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.0",
    "vite": "^5.1.0",
    "vite-plugin-mars3d": "^4.0.0",
    "vue-tsc": "^2.2.12"
  }
}
